{
  "name": "dropshield",
  "version": "1.0.0",
  "private": true,
  "description": "DropShield - Distributed, high-concurrency event ticket booking platform",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:ps": "docker compose ps",
    "dev:frontend": "npm run start --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:worker": "npm run dev:worker --workspace=backend",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "npm run build --workspace=shared",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:migrate:status": "npm run db:migrate:status --workspace=backend",
    "db:rollback": "npm run db:rollback --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "reconcile": "npm run reconcile --workspace=backend",
    "reconcile:dry-run": "npm run reconcile:dry-run --workspace=backend",
    "test": "npm run test:backend",
    "test:backend": "npm run test --workspace=backend",
    "lint": "npm run lint:backend && npm run lint:shared",
    "lint:backend": "npm run lint --workspace=backend",
    "lint:shared": "npm run lint --workspace=shared",
    "format": "prettier --write \"**/*.{ts,js,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,html,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "prettier": "^3.5.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.25.0"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
