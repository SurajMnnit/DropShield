# ==============================================================================
# DropShield - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:4200

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dropshield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration (Inventory Caching & Distributed Locks)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration (Asynchronous Booking Queue)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT Secret & Cookie Configuration (Phase 6)
JWT_SECRET=your_jwt_secret_change_in_production_min32chars
JWT_EXPIRES_IN=1d
COOKIE_SECRET=your_cookie_secret_change_in_production
