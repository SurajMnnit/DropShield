# ==============================================================================
# DropShield - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:4200

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Persistent Relational Storage)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dropshield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dropshield

# ------------------------------------------------------------------------------
# Redis Configuration (Inventory Caching, Distributed Locks & TTL Leases)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# RabbitMQ Configuration (Asynchronous Booking Queue & Management)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ------------------------------------------------------------------------------
# Security & Session Authentication (Phase 6)
# ------------------------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_dropshield_default_development_key_32chars
JWT_EXPIRES_IN=1d
COOKIE_SECRET=dev_cookie_secret_dropshield_development_key_32chars
