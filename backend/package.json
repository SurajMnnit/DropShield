{
  "name": "@dropshield/backend",
  "version": "1.0.0",
  "description": "DropShield high-concurrency API server and background worker",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/scripts/migrate.ts up",
    "db:migrate:status": "tsx src/scripts/migrate.ts status",
    "db:rollback": "tsx src/scripts/migrate.ts down",
    "db:seed": "tsx src/scripts/seed.ts",
    "reconcile": "tsx src/scripts/reconcile.ts",
    "reconcile:dry-run": "tsx src/scripts/reconcile.ts dry-run",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand --forceExit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@dropshield/shared": "*",
    "amqplib": "^2.3.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2"
  }
}
